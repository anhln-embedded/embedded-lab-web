# ============================================
# Git Ignore Configuration - Embedded-AIoT Lab
# ============================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output & Cache
/.next/
/out/
/build/
tsconfig.tsbuildinfo

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
.cloudflared/
backups/
*.tar.gz

# Allow committing sample environment file
!.env.example

# SQLite Database local files (tránh xung đột dữ liệu runtime)
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal
*.sqlite
*.sqlite3

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & Coverage
/coverage

# Temporary files & Scratch data
/tmp
/tmp/
tmp/
*.tmp
.tempmediaStorage

# Vercel & Deployment tools
.vercel

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
